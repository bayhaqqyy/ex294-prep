# shellcheck shell=bash
# Profil default: self-lab VM pribadi (dokumen "Preparation Self-Lab RHCE9 EX294").
#   workstation.lab.example.com 10.10.101.91  -> control node + content.example.com (httpd)
#   servera .92 (dev) · serverb .93 (test) · serverc .94 (prod) · serverd .95 (balancers)
: "${CONTROL_IP:=10.10.101.91}"
: "${DEV_HOSTS:=servera.lab.example.com}"
: "${TEST_HOSTS:=serverb.lab.example.com}"
: "${PROD_HOSTS:=serverc.lab.example.com}"
: "${BAL_HOSTS:=serverd.lab.example.com}"

# Akses node: user student + SSH key student + sudo NOPASSWD (tidak ada key root)
: "${SSH_USER:=student}"
: "${STUDENT:=student}"
: "${STUDENT_PW:=redhat}"
: "${KEY_TO_ROOT:=no}"

# Content server = httpd di workstation, docroot /var/www/html
: "${MAT_SERVER:=httpd}"
: "${MAT_ROOT:=/var/www/html}"

# DVD RHEL 9 yang di-mount ke docroot
: "${REPO_PREFIX:=http://content.example.com/rhel9.0/x86_64/dvd}"
: "${REPO_DVD_DEV:=/dev/sr0}"
: "${REPO_DVD_DIR:=/var/www/html/rhel9.0/x86_64/dvd}"

# Soal 18 (sesuai tabel dokumen): servera & serverc VG > 1500M, serverb ~1G, serverd tanpa VG
: "${RESEARCH_BIG_HOSTS:=servera.lab.example.com serverc.lab.example.com}"
: "${RESEARCH_SMALL_HOSTS:=serverb.lab.example.com}"
